{
  "description": "Claude Orchestrator session hooks: reports plugin version drift, injects testing-mode context on every session start, and flags a skipped /wrap-up before the previous clear.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\" clear",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
